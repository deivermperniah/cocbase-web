---
import { Image } from "astro:assets";
import IconLayers from "~icons/ph/stack";
import MainLayout from "@/layouts/MainLayout.astro";
import AppButton from "@/components/ui/AppButton.vue";
import HeroRotator from "@/components/home/HeroRotator.vue";
import { BASE_LEVELS } from "@/lib/constants";

const baseImages = Object.values(
  import.meta.glob<{ default: ImageMetadata }>("@/assets/images/bases/*.webp", { eager: true }),
).map((mod) => mod.default.src);

const townhallImages = import.meta.glob<{ default: ImageMetadata }>("@/assets/images/townhalls/th*.webp", {
  eager: true,
});
const townhalls = BASE_LEVELS.map((level) => ({
  level,
  image: townhallImages[`/src/assets/images/townhalls/th${level}.webp`]!.default,
}));
---

<MainLayout title="Bases de Clash of Clans por ayuntamiento">
  <div class="space-y-16 pb-6">
    <section class="relative pb-6 pt-10 sm:pt-16">
      <div
        class="pointer-events-none absolute left-1/2 top-14 -z-10 h-56 w-[36rem] max-w-full -translate-x-1/2 rounded-full bg-primary/10 blur-3xl"
      >
      </div>

      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-14">
        <div class="text-center lg:text-left">
          <h1 class="text-4xl leading-none text-white sm:text-5xl lg:text-6xl">Tus bases de Clash of Clans</h1>
          <p class="mx-auto mt-4 max-w-xl font-body text-sm leading-relaxed text-muted-foreground sm:text-base lg:mx-0">
            Encuentra, guarda y comparte diseños de base organizados por nivel de ayuntamiento. Todo revisado por la
            comunidad.
          </p>
          <div class="mt-8 flex items-center justify-center gap-3 lg:justify-start">
            <AppButton href="/bases" size="lg" icon={IconLayers}>Ver bases</AppButton>
            <AppButton href="/contribuir" size="lg" variant="outline">Contribuir</AppButton>
          </div>
        </div>

        <div class="relative">
          <div
            class="pointer-events-none absolute -inset-3 -z-10 rounded-3xl bg-gradient-to-br from-primary/25 via-primary/5 to-transparent blur-2xl"
          >
          </div>
          <div class="overflow-hidden rounded-2xl border border-primary/30 bg-chrome shadow-2xl shadow-primary/10">
            <HeroRotator client:load images={baseImages} />
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="mb-6 flex items-end justify-between">
        <h2 class="text-2xl text-white sm:text-3xl">Explora por ayuntamiento</h2>
        <a href="/bases" class="text-xs text-primary transition-colors hover:text-yellow-300">Ver todas</a>
      </div>

      <div class="group overflow-hidden">
        <div class="flex w-max animate-marquee group-hover:[animation-play-state:paused]">
          {
            [...townhalls, ...townhalls].map((th) => (
              <a
                href={`/bases/th-${th.level}`}
                class="group/card mr-3 block h-56 w-56 shrink-0 overflow-hidden rounded-xl border border-border bg-card transition-all duration-300 hover:border-primary/60 hover:shadow-xl hover:shadow-primary/10"
              >
                <Image
                  src={th.image}
                  alt={`Ayuntamiento nivel ${th.level}`}
                  width={480}
                  height={480}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover/card:scale-105"
                />
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</MainLayout>
