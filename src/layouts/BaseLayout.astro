---
import "@/styles/global.css";
import ToastContainer from "@/components/layout/ToastContainer.vue";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="preload" href="/fonts/lilita-one-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/rubik-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} · cocbase</title>
  </head>
  <body>
    <slot />
    <ToastContainer client:only="vue" />
  </body>
</html>
